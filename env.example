# Copy this file to .env and fill in the values. Never commit .env to GitHub.

TELEGRAM_BOT_TOKEN=paste_token_from_botfather
GEMINI_API_KEY=paste_key_from_google_ai_studio

# Check Google AI Studio for the current model names and free-tier limits
GEMINI_MODEL=gemini-flash-lite-latest

# Your public HTTPS URL (ngrok / Cloudflare Tunnel / your deployed server), no trailing slash
PUBLIC_URL=https://your-public-url.example

# Any random string using only letters, digits, _ and -  (Telegram sends it back on every request)
WEBHOOK_SECRET=change_this_to_a_random_string

# Password for the owner's /leads page
ADMIN_KEY=change_this_too

# Optional: owner's Telegram chat id (message @userinfobot to find it) for instant new-lead alerts.
# The owner must also press Start on your bot once, or Telegram won't let the bot message them.
OWNER_CHAT_ID=

INSTITUTE_NAME=Brightpath Academy
